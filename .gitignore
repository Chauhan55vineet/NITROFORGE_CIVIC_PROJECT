# ==============================================
# CivicPulse AI — .gitignore
# ==============================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# BUT keep .env.example
!.env.example

# Database files (runtime generated — Render uses ephemeral disk)
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal

# Uploaded evidence images (user-generated at runtime)
backend/uploads/*
!backend/uploads/.gitkeep

# Logs
*.log
logs/

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE / editors
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json
